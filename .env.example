# Скопируй этот файл в .env и заполни значения для локального запуска.
# .env закоммичен в .gitignore — реальные секреты в git не попадут.

POSTGRES_DB=webMarketUsers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Внешние порты, на которых сервисы будут доступны на хосте.
POSTGRES_PORT=5432
APP_PORT=8080
